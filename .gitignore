# Never commit a filled-in credential env file: it holds an Axiom ingestion
# token.
#
# `*.env` also matches two TRACKED files under the skill payload that the
# scripts source. They must be re-included explicitly, otherwise a clean clone
# is missing them and every script aborts on an unbound variable.
*.env
!*.env.example
!skills/pm2-logs-agent/assets/tag-policy.env
!skills/pm2-logs-agent/assets/vector-version.env
pm2-axiom.env

# Audit and verification output may contain host paths and addresses.
pm2-logs-audit-*.md
pm2-logs-audit-*.json
verify-*.json

# Rendered configs carry resolved host paths.
rendered*.toml
*.rendered.toml

# Local scratch
*.swp
*.bak
*.orig
*~
.DS_Store
