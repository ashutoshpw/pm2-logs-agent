# Never commit a filled-in credential env file: it holds an Axiom ingestion
# token.
#
# The two TRACKED files assets/tag-policy.env and assets/vector-version.env are
# matched by `*.env` and must be re-included, otherwise a clean clone is missing
# them and every script aborts on an unbound variable.
*.env
!*.env.example
!assets/tag-policy.env
!assets/vector-version.env
pm2-axiom.env

# Audit and verification output may contain host paths and addresses.
pm2-logs-audit-*.md
pm2-logs-audit-*.json
verify-*.json

# Rendered configs carry resolved host paths.
rendered*.toml
*.rendered.toml

# Local scratch
*.swp
*.bak
*.orig
*~
.DS_Store
