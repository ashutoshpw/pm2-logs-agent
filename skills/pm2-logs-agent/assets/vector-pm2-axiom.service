[Unit]
Description=pm2-logs-agent — PM2 logs to Axiom
Documentation=https://github.com/ashutoshpw/pm2-logs-agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vector
Group=vector

# Credentials and tags. MUST be mode 0600 and root-owned.
EnvironmentFile=/etc/vector/pm2-axiom.env

# --require-healthy makes Vector exit if the Axiom sink fails its startup
# healthcheck, so systemd surfaces a broken pipeline instead of leaving a
# silently degraded process running. Combine with Restart=always and
# RestartSec for a retry loop rather than a one-shot failure.
# --require-healthy takes an explicit boolean value. Bare `--require-healthy`
# immediately followed by the next argument makes Vector fail to parse its own
# command line, so the service never starts.
ExecStart=/usr/bin/vector --config /etc/vector/pm2-axiom.toml --config /etc/vector/host-insights.toml --require-healthy true

# The axiom sink's dataset and token are config-level ${VAR} interpolations,
# which Vector disables unless this is set. VECTOR_STRICT_ENV_VARS defaults to
# true, so a missing SECRET_AXIOM_TOKEN aborts config load instead of sending a
# literal placeholder and 401ing every batch. Run scripts/smoke-test.sh BEFORE
# enabling this unit so that failure appears as a clear message rather than a
# restart loop.
#
# This flag exists because a templated field can otherwise be influenced by a
# log producer; the token and dataset here are operator-controlled, so the
# exposure is limited. See references/risk-tiers.md.
Environment=VECTOR_DANGEROUSLY_ALLOW_ENV_VAR_INTERPOLATION=true

# Reloads the config on SIGHUP, matching Vector's graceful reload behaviour.
ExecReload=/bin/kill -HUP $MAINPID

Restart=always
RestartSec=5s

# Do not kill the process on the final SIGTERM immediately; let in-flight
# batches drain to the disk buffer. Must exceed Vector's own 60s default.
KillSignal=SIGTERM
TimeoutStopSec=90

# ---- hardening -----------------------------------------------------------
# Read access to the PM2 log dir must be granted to the vector user, e.g.:
#   usermod -aG deploy vector
# or by ACL:
#   setfacl -R -m u:vector:rX /home/deploy/.pm2/logs
#
# ProtectHome=read-only still allows READING /home, which is required here.
# Do NOT use ProtectHome=true: it would block the PM2 log directory entirely
# and Vector would silently ingest nothing.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/vector
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target