# pm2-logs-agent — tag policy
#
# Rules enforced by scripts/validate-tags.sh and honoured by
# assets/apply-tags.vrl. Keep this file and the VRL in sync.

# Tags that MUST NEVER be set from user input. Two groups:
#
#  1. Axiom system fields. Axiom refuses to delete these, and a lock-schema
#     dataset reserves them. See https://axiom.co/docs/reference/datasets
#  2. Fields this pipeline derives itself from the PM2 log filename. If a user
#     tag clobbered these, every event would be mislabelled.
TAG_RESERVED_NAMES="_time _sysTime message app stream severity host file pm2_pid pid command source_type timestamp data_stream service machine public_ip tailscale_ip"

# The machine tag is mandatory — without it the dataset is not queryable by
# host. See SKILL.md "Step 3 — identity".
TAG_REQUIRED_NAMES="machine"

# Tag keys are emitted into Axiom as columns. Axiom is columnar, so an
# unbounded value here becomes an expensive, useless column. These suffixes
# are rejected by default because they almost always carry unbounded values
# (request ids, container ids, timestamps).
TAG_REJECT_KEY_SUFFIXES="_id _uuid _guid _at _timestamp _epoch _pid _rand"

# Maximum number of tags (excluding the pipeline's own derived fields). Axiom
# documents "field count explosion" as an anti-pattern on a single dataset.
TAG_MAX_COUNT=16

# Tag key/value length limits. Axiom dataset names are 1-128 chars; field
# names have no documented hard limit but pathological names break tooling.
TAG_MAX_KEY_LEN=64
TAG_MAX_VALUE_LEN=256