# pm2-logs-agent — pinned Vector version
#
# This file is the single source of truth for the Vector version this skill
# installs, validates against, and reports drift for. Nothing else should
# hardcode a Vector version.
#
# Updated: 2026-10-07
# Source:  https://github.com/vectordotdev/vector/releases/tag/v0.59.0
# Checksums: vector-0.59.0-SHA256SUMS (same release)
#
# Known-good floor. v0.59.0 was one day old when pinned, so CI also validates
# every template against this version. If a host is older than the floor the
# skill reports the drift instead of blindly proceeding.
VECTOR_VERSION=0.59.0
VECTOR_KNOWN_GOOD_FLOOR=0.58.0

# Release asset checksums (amd64 shown; see install-vector-pinned.sh for the
# full arch matrix, which re-reads SHA256SUMS from the release itself).
VECTOR_SHA256_amd64_deb=1dd9f52bda25d2364ab04d496a3b7edbc775b1a3cd02d9985eb81f3c174a245f
VECTOR_SHA256_amd64_targz=fb15878d1cd68445e0658792a8fa7ccf02ae8a353c6cc5d6fe867b171993e19f

# Container image used for `vector validate` in CI.
VECTOR_CI_IMAGE=timberio/vector:0.59.0-debian