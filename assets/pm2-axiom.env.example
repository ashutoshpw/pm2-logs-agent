# pm2-logs-agent — Axiom credentials and tags
#
# Copy to /etc/vector/pm2-axiom.env, fill in, then:
#     chmod 0600 /etc/vector/pm2-axiom.env
#     chown root:root /etc/vector/pm2-axiom.env
#
# NEVER commit a filled-in copy of this file. NEVER paste a real token into a
# report, a chat message, or a git commit. validate-tags.sh and
# render-vector-config.sh both redact AXIOM_TOKEN in any output they print.

# ---------------------------------------------------------------------------
# Axiom connection
# ---------------------------------------------------------------------------

AXIOM_DATASET=pm2-logs

# Ingestion token with ingest permission for AXIOM_DATASET only.
# Create at Axiom -> Settings -> Tokens. Prefer a service-account token.
AXIOM_TOKEN=

# OPTIONAL. Leave this UNSET unless your organization uses a non-default edge
# deployment. When omitted, Vector's axiom sink uses Axiom's default base
# domain (api.axiom.co), which is correct for the majority of accounts.
#
# Set it only if Axiom -> Settings -> General shows an edge deployment other
# than the default. No scheme, no trailing slash. Known values:
#   us-east-1.aws.edge.axiom.co     (US East 1, AWS)
#   eu-central-1.aws.edge.axiom.co  (EU Central 1, AWS)
#
# Getting this wrong sends data to the wrong edge deployment, which is worse
# than not setting it at all.
#AXIOM_REGION=us-east-1.aws.edge.axiom.co

# Only set this when AXIOM_TOKEN is a *personal* token. Service-account
# tokens must not have it set.
#AXIOM_ORG_ID=

# Separate dataset for the 30-minute host insights stream. Kind must be
# "Metrics" when creating it. Keeping this out of the logs dataset follows
# Axiom's own "separate by signal type" guidance.
AXIOM_INSIGHTS_DATASET=pm2-host-insights

# ---------------------------------------------------------------------------
# Identity tags
# ---------------------------------------------------------------------------
#
# Every VECTOR_TAG_* variable becomes a lowercase field on every event in
# both the logs pipeline and the host-insights pipeline. If a variable is
# absent, the field is simply absent — that is how optional tags work, with
# no special handling.

# MANDATORY. Human-friendly host name. Suggested default is $(hostname).
VECTOR_TAG_MACHINE=

# OPTIONAL. Probed at setup by scripts/probe-network.sh. Omit the line
# entirely if the probe failed or you would rather not ship it.
#
# Note: a public IP address may count as personal data under GDPR-style
# regimes. That is your call to make, not this skill's — but make it
# deliberately.
#VECTOR_TAG_PUBLIC_IP=

# OPTIONAL. Present only when Tailscale is installed and active.
#VECTOR_TAG_TAILSCALE_IP=

# OPTIONAL, chosen from a curated set: env region role team cluster
# service deploy_id
#
# Warning: Axiom's own dataset guidance prefers a separate dataset per
# environment over an `env` attribute, because an `env` filter silently gets
# forgotten in queries. If you add VECTOR_TAG_ENV, consider a dedicated
# dataset instead. The skill will flag this, not block it.
#VECTOR_TAG_ENV=
#VECTOR_TAG_REGION=
#VECTOR_TAG_ROLE=
#VECTOR_TAG_TEAM=
#VECTOR_TAG_CLUSTER=
#VECTOR_TAG_SERVICE=
#VECTOR_TAG_DEPLOY_ID=

# ---------------------------------------------------------------------------
# Host insights behaviour
# ---------------------------------------------------------------------------

# Snapshot cadence in seconds. 1800 = every 30 minutes.
PM2_INSIGHTS_INTERVAL_SECS=1800

# Filesystem types to exclude from the per-disk breakdown. tmpfs, devtmpfs,
# proc, sysfs, cgroup, ramfs, squashfs and loop devices are noise.
# Add "overlay" here if you are containerised and do not want the host's
# overlay layers reported.
PM2_INSIGHTS_DISK_FS_EXCLUDE="tmpfs devtmpfs proc sysfs cgroup cgroup2 ramfs squashfs devfs"

# Hard cap on how many filesystems appear in one snapshot, so a pathological
# `df` cannot produce an unbounded array.
PM2_INSIGHTS_MAX_DISKS=32